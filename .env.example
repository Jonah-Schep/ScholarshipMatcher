# Copy to .env and fill in. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# anthropic | openai_compat | offline      (default: anthropic if a key is found, else offline)
SM_LLM_PROVIDER=
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoint, e.g. VT ARC (https://llm-api.arc.vt.edu/api/v1)
SM_OPENAI_BASE_URL=
SM_OPENAI_API_KEY=
SM_OPENAI_MODEL=

# Per-role model overrides (Anthropic provider). Default for every role: claude-opus-5-5
SM_MODEL_EXTRACTOR=
SM_MODEL_FILTER=
SM_MODEL_SCORER=
SM_MODEL_VERIFIER=
SM_MODEL_CHAT=

# --- Scrapers ---------------------------------------------------------------
# Required to run any scraper: goes in the User-Agent so site owners can reach you.
SCRAPER_CONTACT_EMAIL=
# CareerOneStop Web API (register yourself at careeronestop.org/Developers)
COS_USER_ID=
COS_API_TOKEN=
